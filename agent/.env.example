# 复制本文件为 .env，填入你自己的值（config.py 读取同目录 .env）
# 真实 key 属你私有，不要提交 git、不要打包外发。

# ---- 服务自身 ----
AGENT_HOST=127.0.0.1
AGENT_PORT=8001

# ---- 后端 REST 服务地址 ----
BACKEND_BASE_URL=http://127.0.0.1:8000

# ---- 数据库（rule_engine 的 SqlDataSource 用，与后端同一库）----
DATABASE_URL=postgresql+psycopg://diet_app:diet_app_dev@localhost:5432/diet_agent

# ---- DeepSeek 大模型 ----
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---- 后端代码目录（用于 import rule_engine，一般不用改）----
# BACKEND_DIR=../backend
