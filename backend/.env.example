# 复制为 .env 后按环境修改
# 注意：diet_app 是 03 脚本建的 NOLOGIN 权限组，不能当登录账号；
# 后端要自己的 LOGIN 账号并 GRANT diet_app 给它（见 database/03 末尾示例）
DATABASE_URL=postgresql+psycopg://diet_backend:<password>@localhost:5432/diet_agent
JWT_SECRET=<random-secret>
JWT_ALGORITHM=HS256
TOKEN_EXPIRE_MINUTES=1440
APP_HOST=127.0.0.1
APP_PORT=8000

# Embedding / RAG（bge-m3，1024 维定死，改维度须重建 pgvector 索引）
# 方案 A 云端 SiliconFlow（默认，API key 去 siliconflow.cn 注册，有免费额度）
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_API_KEY=<siliconflow-api-key>
# 方案 B 本地 Ollama（切到本地时改用下面三行）
# EMBEDDING_BASE_URL=http://127.0.0.1:11434
# EMBEDDING_MODEL=bge-m3
# EMBEDDING_API_KEY=ollama

EMBEDDING_DIM=1024
EMBEDDING_TIMEOUT_S=30
RAG_RRF_K=60

# Agent 服务地址（agent/ 目录的 FastAPI），/agent/chat 会代理到这里
AGENT_BASE_URL=http://127.0.0.1:8001
AGENT_TIMEOUT_S=60
